# Local development defaults. Override every value in your production
# environment — never ship the dev AUTH_SECRET.

# PostgreSQL connection string (used by Prisma CLI and the app runtime).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fet_black_tie"

# Secret used to sign staff session cookies (JWT, HS256).
# Generate a strong value for production: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-in-production"

# Fapshi payment gateway.
# https://sandbox.fapshi.com for testing, https://live.fapshi.com for production.
FAPSHI_BASE_URL=""
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
# Shared secret Fapshi sends in the x-wh-secret header of webhook calls.
FAPSHI_WEBHOOK_SECRET=""

# Optional: used once by `npm run db:seed` to create the first admin account.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
